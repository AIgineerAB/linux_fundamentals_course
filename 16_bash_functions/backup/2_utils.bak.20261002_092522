#!/usr/bin/env bash

# file_exists - checks if a file exists and returns 0 if it does and 1 if it doesn't
# usage: file_exists <filename>
file_exists() {
  # local to have local scoping of variable
  local file="$1"
  if [[ -f "$file" ]]; then
    return 0
  else
    return 1
  fi
}

# mkcd - create a directory and cd into it
# usage: mkcd <dirname>
mkcd() {
	mkdir -p "$1" && cd "$1"
}

# bak - backs up a file and add timestamp to it
# utils: bak <file>
bak() {
	local backup="$1.bak.$(date +%Y%m%d_%H%M%S)"
	cp "$1" "$backup"
	echo "$backup" 
}

# bakd - backup all files in a directory
# usage: bakh <source_dir> <dest_dir>
bakd () {
	local src="$1"
	local dest="$2"
	mkdir -p "$dest"

	[[ -d "$src" ]] || return 1

	for file in "$src"/*; do 
		[[ -f $file ]] || continue 
		local backup="$(bak "$file")"
		mv "$backup" "$dest/"
	done
}